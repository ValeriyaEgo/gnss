                }
              },
              ".image-wrapper": {
                "margin-top": "70px",
                "@media (max-width: 992px)": {
                  "margin-top": "40px"
                },
                "& when (@showShadow)": {
                  "-webkit-mask-image": "linear-gradient(#000000 80%, transparent 95%)",
                  "mask-image": "linear-gradient(#000000 80%, transparent 95%)"
                },
                "img": {
                  "height": "690px",
                  "width": "100%",
