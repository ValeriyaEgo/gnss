          "_name": "article03",
          "_sourceTheme": "launchm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article03 launchm5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" condition=\"showLabel\" checked>\n        <input type=\"color\" title=\"Label Bg\" value=\"#fafafa\" name=\"labelBg\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"shadow_1\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"shadow_2\" condition=\"showLabel\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\" checked>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"cardShadow_1\">\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"cardShadow_2\">\n        <input type=\"color\" title=\"Container BG\" value=\"#fafafa\" name=\"cardBg\">\n        <header>Border</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Color\" value=\"#e1e7ed\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f5f5\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f5f5f5\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"border-wrap border_1\"></div>\n                    <div class=\"border-wrap border_2\"></div>\n                    <div class=\"card-wrapper\">\n                        <div class=\"row items-wrapper justify-content-center\">\n                            <div class=\"col-12 col-lg-6 card\">\n                                <div class=\"title-wrapper\">\n                                    <div class=\"label-wrapper\" mbr-if=\"showLabel\">\n                                        <div class=\"label-wrap card-wrap large-radius\">\n                                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                <span mbr-icon class=\"card-icon mbr-iconfont mobi-mbri-setting-3 mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(51, 65, 85); fill: rgb(51, 65, 85);\"></span>\n                                            </div>\n                                            <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-label, .label-wrapper\">\n                                                Official DJI Enterprise Dealer</p>\n                                        </div>\n                                    </div>\n                                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                                        About Us</h2>\n                                </div>\n                            </div>\n                            <div class=\"col-12 col-lg-6 card\">\n                                <div class=\"text-wrapper\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">GNSS.AE is a leading GNSS and drone technology company headquartered in the UAE, empowering organizations across the Middle East and Africa with precision-driven solutions. We deliver centimeter-level GNSS RTK systems, enterprise-grade drones, advanced LiDAR, sensors, and 3D scanning technologies designed to elevate accuracy, efficiency, and operational performance.<br><br>\n                                        From intelligent software and seamless system integration to expert training and dedicated support, GNSS.AE provides complete, end-to-end geospatial and aerial solutions. We don’t just supply technology: we enable businesses to execute projects with greater confidence, safety, and measurable results.\n                                    </p>\n                                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                                        <a class=\"btn btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                            View More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"col-12 card\">\n                                <div class=\"image-wrapper\" mbr-if=\"showImage\">\n                                    <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/mbr-1920x1280.jpg\" alt=\"Mobirise Website Builder\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v4MhZjtWQk",
          "_anchor": "article03-a",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@showBorder)": {
              "overflow": "hidden"
            },
            ".content-wrapper": {
              "position": "relative",
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "center",
              "padding-bottom": "(@paddingBottom * 1rem)",
              "& when (@showBorder)": {
                "padding-left": "20px",
                "padding-right": "20px",
                "border-bottom": "1px solid @border",
                "@media (max-width: 425px)": {
                  "padding-left": "0",
                  "padding-right": "0"
                },
                ".border-wrap": {
                  "position": "absolute",
                  "height": "1000%",
                  "width": "1px",
                  "border-left": "1px solid @border",
                  "pointer-events": "none",
                  "@media (max-width: 425px)": {
                    "display": "none"
                  }
                },
                ".border_1": {
                  "left": "0"
                },
                ".border_2": {
                  "right": "0"
                }
              },
              ".title-wrapper": {
                "margin-bottom": "40px",
                ".label-wrapper": {
                  "margin-bottom": "16px",
                  ".label-wrap": {
                    "display": "inline-flex",
                    "align-items": "center",
                    "padding": "7px 18px",
                    "box-shadow": "inset 0 10px 8px 0 @shadow_1, inset 0 -5px 10px -8px @shadow_2, 0 10px 10px -8px @shadow_2",
                    "background-color": "@labelBg",
                    ".iconfont-wrapper": {
                      "display": "inline-flex",
                      ".mbr-iconfont": {
                        "font-size": "18px",
                        "display": "inline-flex",
                        "margin-right": "8px"
                      }
                    },
                    ".mbr-label": {
                      "margin-bottom": "0"
                    }
                  }
                },
                ".mbr-section-title": {
                  "margin-bottom": "16px"
                },
                ".text-wrapper": {
                  ".mbr-text": {
                    "display": "inline-block",
                    "width": "50%",
                    "margin-bottom": "0",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    }
                  }
                }
              }
            },
            ".items-wrapper": {
              "margin": "0 -10px",
              ".item": {
                "padding": "0 10px",
                "margin-bottom": "20px",
                "@media (max-width: 992px)": {
                  "&:last-child": {
                    "margin-bottom": "0"
                  }
                },
                "&:hover, &:focus": {
                  ".item-wrapper": {
                    "box-shadow": "inset 0 10px 8px 0 @cardShadow_1, inset 0 -5px 10px -4px @cardShadow_2, 1px 10px 20px -5px @activeColor",
                    "transform": "translateY(-3px)",
                    ".item-img": {
                      "&::before": {
                        "opacity": ".4"
                      },
                      "&::after": {
                        "opacity": ".1"
                      }
                    },
                    ".item-title": {
                      "color": "@activeColor"
                    }
                  }
                },
                ".item-wrapper": {
                  "display": "flex",
                  "flex-direction": "column",
                  "justify-content": "space-between",
                  "height": "100%",
                  "padding": "24px",
                  "background-color": "@cardBg",
                  "box-shadow": "inset 0 10px 8px 0 @cardShadow_1, inset 0 -5px 10px -4px @cardShadow_2, 0 10px 10px -5px @cardShadow_2",
                  "overflow": "hidden",
                  "transition": "all .3s ease",
                  "@media (max-width: 992px)": {
                    "padding": "20px"
                  },
                  ".item-img": {
                    "margin-bottom": "20px",
                    "position": "relative",
                    "&::before": {
                      "content": "''",
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "width": "100%",
                      "height": "100%",
                      "box-shadow": "inset 0 5px 15px 0 @cardBg, inset 0 -10px 15px 0 @cardBg",
                      "transition": "all .3s ease",
                      "pointer-events": "none",
                      "z-index": "1",
                      "opacity": "0"
                    },
                    "&::after": {
                      "content": "''",
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "width": "100%",
                      "height": "100%",
                      "background-color": "@cardShadow_1",
                      "opacity": "0",
                      "transition": "all .3s ease",
                      "pointer-events": "none",
                      "z-index": "1"
                    },
                    "img": {
                      "height": "280px",
                      "width": "100%",
                      "object-fit": "cover",
                      "@media (max-width: 992px)": {
                        "height": "320px"
                      }
                    }
                  },
                  ".item-date": {
                    "margin-bottom": "8px"
                  },
                  ".item-title": {
                    "margin-bottom": "0",
                    "transition": "all .3s ease"
                  },
                  ".item-text": {
                    "margin-bottom": "0",
                    "margin-top": "12px"
                  },
                  ".mbr-section-btn": {
                    "margin-top": "10px",
                    ".btn": {
                      "margin-bottom": "0"
                    }
                  }
                }
              }
            },
            ".mbr-label, .label-wrapper": {
              "color": "#334155",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#0f172a",
              "text-align": "center"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#475569",
              "text-align": "center"
            },
            ".item-date": {
              "color": "#334155"
            },
            ".item-title": {
              "color": "#0f172a"
            },
            ".item-text": {
              "color": "#475569"
            }
          },
          "_name": "features03",
          "_sourceTheme": "launchm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features03 launchm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" condition=\"showLabel\" checked>\n        <input type=\"color\" title=\"Label Bg\" value=\"#fafafa\" name=\"labelBg\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"shadow_1\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"shadow_2\" condition=\"showLabel\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Date\" name=\"showDate\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"cardShadow_1\">\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"cardShadow_2\">\n        <input type=\"color\" title=\"BG\" value=\"#fafafa\" name=\"cardBg\">\n        <input type=\"color\" title=\"Active Color\" value=\"#bf0012\" name=\"activeColor\">\n        <header>Border</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Color\" value=\"#e1e7ed\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f5f5\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f5f5f5\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"border-wrap border_1\"></div>\n                    <div class=\"border-wrap border_2\"></div>\n                    <div class=\"title-wrapper\" mbr-if=\"showLabel || showTitle || showText\">\n                        <div class=\"label-wrapper\" mbr-if=\"showLabel\">\n                            <div class=\"label-wrap card-wrap large-radius\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"card-icon mbr-iconfont mobi-mbri-calendar mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(51, 65, 85); fill: rgb(51, 65, 85);\"></span>\n                                </div>\n                                <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-label, .label-wrapper\">\n                                    Ecommerce Events\n                                </p>\n                            </div>\n                        </div>\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Technology Insights &amp; Trends</h2>\n                        <div class=\"text-wrapper\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                Stay informed with insights on emerging technologies, industry innovations, and best practices driving operational efficiency and precision.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"row items-wrapper justify-content-center\">\n                        <div class=\"col-12 col-lg-6 item features-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-content\">\n                                    <div class=\"item-img card-wrap little-radius\">\n                                        <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/gis-in-drone-operations-912x765.jpeg\" alt=\"Mobirise Website Builder\">\n                                    </div>\n                                    <p class=\"item-date mbr-fonts-style\" mbr-if=\"showDate\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\">\n                                        January 10, 2026</p>\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">Understanding GIS Deliverables in Professional UAV Operations</h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                        A practical, interactive session focused on improving online store performance.\n                                        Topics include optimizing product pages, strengthening customer experience, and\n                                        creating a scalable marketing strategy for consistent growth.\n                                    </p>\n                                    <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href class=\"btn btn-black\" data-app-placeholder=\"Type Text\">\n                                            View More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-6 item features-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-content\">\n                                    <div class=\"item-img card-wrap little-radius\">\n                                        <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/gnss-912x765.png\" alt=\"Mobirise Website Builder\">\n                                    </div>\n                                    <p class=\"item-date mbr-fonts-style\" mbr-if=\"showDate\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\">\n                                        December 29, 2025</p>\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">Navigating GNSS Surveying Challenges in Complex Environments</h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                        An intensive program designed to help small business owners master digital\n                                        marketing essentials.\n                                        Participants learn about SEO, social media ads, email automation, and customer\n                                        retention tactics that drive long-term ecommerce success.\n                                    </p>\n                                    <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href class=\"btn btn-black\" data-app-placeholder=\"Type Text\">\n                                            View More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vaVLl6Iupy",
          "_anchor": "features03-4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
