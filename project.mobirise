                },
                ".item-wrapper": {
                  "height": "100%",
                  "padding": "24px",
                  "overflow": "hidden",
                  "background-color": "@cardBg",
                  "box-shadow": "inset 0 10px 8px 0 @cardShadow_1, inset 0 -5px 10px -4px @cardShadow_2, 0 10px 10px -5px @cardShadow_2",
                  "position": "relative",
                  "@media (max-width: 992px)": {
                    "padding": "20px"
                  },
                  "&::before": {
                    "content": "''",
                    "position": "absolute",
                    "top": "0",
                    "left": "0",
                    "width": "100%",
                    "height": "100%",
                    "background-image": "radial-gradient(100% 100% at 100% 100%, @gradient 0%, transparent 100%)",
                    "opacity": "@gradientOpacity",
                    "pointer-events": "none"
                  },
                  ".item-img": {
                    "margin-bottom": "20px",
                    "img": {
                      "height": "320px",
                      "width": "100%",
                      "object-fit": "cover"
                    }
                  },
                  ".item-price": {
