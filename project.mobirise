                          "margin-bottom": "0"
                        }
                      }
                    }
                  },
                  ".item-text": {
                    "position": "relative",
                    "z-index": "1",
                    "margin-bottom": "0"
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "54%",
              "width": "42px",
              "height": "42px",
              "font-size": "26px",
              "background-color": "@arrowsBg !important",
              "color": "@arrowsColor !important",
              "border": "none !important",
              "border-radius": "100% !important",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "box-shadow": "inset 0 2px 10px -2px @arrowsShadow, 0 10px 10px -2px @arrowsShadow",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "@media (max-width: 992px)": {
                "bottom": "0"
              },
              "&:hover": {
                "transform": "translateY(-3px)"
              },
              "&:disabled": {
                "opacity": ".5 !important",
                "transform": "none"
              },
              "&.embla__button--prev": {
                "left": "0"
              },
              "&.embla__button--next": {
                "right": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "display": "flex",
              "justify-content": "center",
              "@media (max-width: 992px)": {
                "& when (@arrows)": {
                  "padding-bottom": "4rem"
                }
              }
            },
            ".embla__viewport": {
              "position": "relative",
              "overflow": "hidden",
              "width": "100%",
              "padding-bottom": "20px",
              "@media (max-width: 992px)": {
                "padding-left": "0",
                "padding-right": "0"
              },
              "& when (@shadow)": {
                "mask-image": "linear-gradient(to right, transparent 0%, #000000 12.5%, #000000 87.5%, transparent 100%)",
                "-webkit-mask-image": "linear-gradient(to right, transparent 0%, #000000 12.5%, #000000 87.5%, transparent 100%)",
                "@media (max-width: 768px)": {
                  "mask-image": "none",
                  "-webkit-mask-image": "none"
                }
              }
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-menu-overlay": {
              "opacity": "0 !important"
            },
            ".mbr-label, .label-wrapper": {
              "color": "#334155",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#0f172a",
              "text-align": "center"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#475569",
              "text-align": "center"
            },
            ".item-name": {
              "color": "#0f172a"
            },
            ".item-role": {
              "color": "#475569"
            },
            ".item-text": {
              "color": "#475569"
            }
          },
          "_name": "slider01",
          "_sourceTheme": "launchm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider01 mbr-embla launchm5\" group=\"People\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" condition=\"showLabel\" checked>\n        <input type=\"color\" title=\"Label Bg\" value=\"#fafafa\" name=\"labelBg\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"shadow_1\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"shadow_2\" condition=\"showLabel\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked>\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"3\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" title=\"Shadow\" name=\"shadow\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\">\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <input type=\"color\" name=\"arrowsColor\" title=\"Arrows Color\" value=\"#fafafa\" condition=\"arrows\">\n        <input type=\"color\" name=\"arrowsBg\" title=\"Arrows BG\" value=\"#334155\" condition=\"arrows\">\n        <input type=\"color\" name=\"arrowsShadow\" title=\"Arrows Shadow\" value=\"#cccccc\" condition=\"arrows\">\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"40\" step=\"10\" value=\"30\">\n        <input type=\"checkbox\" title=\"Name\" name=\"showName\" checked>\n        <input type=\"checkbox\" title=\"Role\" name=\"showRole\">\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"cardShadow_1\">\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"cardShadow_2\">\n        <input type=\"color\" title=\"BG\" value=\"#fafafa\" name=\"cardBg\">\n        <header>Border</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Color\" value=\"#e1e7ed\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f5f5\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f5f5f5\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"border-wrap border_1\"></div>\n                    <div class=\"border-wrap border_2\"></div>\n                    <div class=\"title-wrapper\" mbr-if=\"showLabel || showTitle || showText\">\n                        <div class=\"label-wrapper\" mbr-if=\"showLabel\">\n                            <div class=\"label-wrap card-wrap large-radius\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"card-icon mbr-iconfont mbrib-star\" data-app-selector=\".card-icon\" style=\"color: rgb(51, 65, 85); fill: rgb(51, 65, 85);\"></span>\n                                </div>\n                                <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-label, .label-wrapper\">EXCELLENT</p>\n                            </div>\n                        </div>\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Trusted by Industry Leaders</h2>\n                        <div class=\"text-wrapper\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                Real feedback from clients delivering complex projects with GNSS and drone solutions built for accuracy and efficiency.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                        <div class=\"embla__viewport\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n                            <div class=\"embla__container\">\n                                <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"person-wrapper\">\n                                                <div class=\"person-wrap\">\n                                                    <div class=\"item-img\">\n                                                        <img src=\"@PROJECT_PATH@/assets/images/image10.jpg\" alt=\"Mobirise Website Builder\">\n                                                    </div>\n                                                    <div class=\"person-name\" mbr-if=\"showName || showRole\">\n                                                        <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-name\" mbr-if=\"showName\">Punto Prima</h4>\n                                                        <p class=\"item-role mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-role\" mbr-if=\"showRole\">\n                                                            CEO\n                                                        </p>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                                <i>\"</i>We recently purchased the DJI Matrice 4E from this company, and the overall experience was excellent. Mr. Niyas’s response was quick, and the team was very professional. Their service was outstanding from start to finish. They provided clear guidance, great support, and made the whole process smooth. Highly recommended!<i>\"</i>\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"person-wrapper\">\n                                                <div class=\"person-wrap\">\n                                                    <div class=\"item-img\">\n                                                        <img src=\"@PROJECT_PATH@/assets/images/image18.jpg\" alt=\"Mobirise Website Builder\">\n                                                    </div>\n                                                    <div class=\"person-name\" mbr-if=\"showName || showRole\">\n                                                        <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-name, .person-wrapper\" mbr-if=\"showName\">Mir Sarfaraz Hussain</h4>\n                                                        <p class=\"item-role mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-role\" mbr-if=\"showRole\">\n                                                            Operations Director\n                                                        </p>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\"GNSS.AE provided an excellent service experience from start to finish. Mr. Niyas was extremely helpful and professional in guiding me through the entire process of selecting the right GNSS receiver rover set based on my specific project requirements.\"</p>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"person-wrapper\">\n                                                <div class=\"person-wrap\">\n                                                    <div class=\"item-img\">\n                                                        <img src=\"@PROJECT_PATH@/assets/images/image4.jpg\" alt=\"Mobirise Website Builder\">\n                                                    </div>\n                                                    <div class=\"person-name\" mbr-if=\"showName || showRole\">\n                                                        <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-name, .person-wrapper\" mbr-if=\"showName\">Tatenda Zhou</h4>\n                                                        <p class=\"item-role mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-role\" mbr-if=\"showRole\">\n                                                            Founder\n                                                        </p>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                                <i>\"</i>Great service! We bought our drones here and the whole process was super smooth. They helped us with the application and gave really good training too. Big shout-out to Niyas he was friendly, patient, and made everything easy to understand. Definitely recommend!\"</p>\n                                        </div>\n                                    </div>\n                                </div>\n                                \n                                \n                            </div>\n                        </div>\n                        <button class=\"embla__button embla__button--prev\">\n                            <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden visually-hidden visually-hidden\">Previous</span>\n                        </button>\n                        <button class=\"embla__button embla__button--next\">\n                            <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden visually-hidden visually-hidden\">Next</span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v4Mi7JJ7oZ",
          "_anchor": "slider01-c",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@showBorder)": {
              "overflow": "hidden"
            },
            ".content-wrapper": {
              "position": "relative",
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "center",
              "padding-bottom": "(@paddingBottom * 1rem)",
              "& when (@showBorder)": {
                "padding-left": "20px",
                "padding-right": "20px",
                "border-bottom": "1px solid @border",
                "@media (max-width: 425px)": {
                  "padding-left": "0",
                  "padding-right": "0"
                },
                ".border-wrap": {
                  "position": "absolute",
                  "height": "1000%",
                  "width": "1px",
                  "border-left": "1px solid @border",
                  "pointer-events": "none",
                  "@media (max-width: 425px)": {
                    "display": "none"
                  }
                },
                ".border_1": {
                  "left": "0"
                },
                ".border_2": {
                  "right": "0"
                }
              },
              ".title-wrapper": {
                "margin-bottom": "40px",
                ".label-wrapper": {
                  "margin-bottom": "16px",
                  ".label-wrap": {
                    "display": "inline-flex",
                    "align-items": "center",
                    "padding": "7px 18px",
                    "box-shadow": "inset 0 10px 8px 0 @shadow_1, inset 0 -5px 10px -8px @shadow_2, 0 10px 10px -8px @shadow_2",
                    "background-color": "@labelBg",
                    ".iconfont-wrapper": {
                      "display": "inline-flex",
                      ".mbr-iconfont": {
                        "font-size": "18px",
                        "display": "inline-flex",
                        "margin-right": "8px"
                      }
                    },
                    ".mbr-label": {
                      "margin-bottom": "0"
                    }
                  }
                },
                ".mbr-section-title": {
                  "margin-bottom": "16px"
                },
                ".text-wrapper": {
                  ".mbr-text": {
                    "display": "inline-block",
                    "width": "50%",
                    "margin-bottom": "0",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    }
                  }
                }
              }
            },
            ".items-wrapper": {
              "margin": "0 -10px",
              ".card": {
                "padding": "0 10px"
              }
            },
            ".image-wrapper": {
              "position": "relative",
              "height": "100%",
              "width": "100%",
              "min-height": "335px",
              "@media (max-width: 992px)": {
                "min-height": "auto",
                "height": "320px"
              },
              "img": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "object-fit": "cover"
              }
            },
            ".items-wrap": {
              "@media (max-width: 992px)": {
                "margin-bottom": "20px"
              },
              ".item": {
                "margin-bottom": "20px",
                "&:last-child": {
                  "margin-bottom": "0"
                },
                "&:hover, &:focus": {
                  ".item-wrapper .card-box .text-wrap .item-text": {
                    "color": "@activeColor",
                    "&::before": {
                      "opacity": "1",
                      "transform": "translateY(0)"
                    }
                  }
                },
                ".item-wrapper": {
                  "display": "flex",
                  "align-items": "center",
                  "padding": "24px",
                  "background-color": "@cardBg",
                  "box-shadow": "inset 0 10px 8px 0 @cardShadow_1, inset 0 -5px 10px -4px @cardShadow_2, 0 10px 10px -5px @cardShadow_2",
                  "@media (max-width: 992px)": {
                    "padding": "20px",
                    "display": "block"
                  },
                  ".icon-wrapper": {
                    "width": "52px",
                    "min-width": "52px",
                    "margin-right": "16px",
                    "@media (max-width: 992px)": {
                      "margin-right": "0",
                      "margin-bottom": "16px"
                    },
                    ".mbr-iconfont": {
                      "width": "52px",
                      "height": "52px",
                      "min-width": "52px",
                      "font-size": "32px",
                      "display": "inline-flex",
                      "align-items": "center",
                      "justify-content": "center",
                      "background-color": "@iconBg",
                      "box-shadow": "inset 0 2px 10px -2px @iconShadow, 0 10px 10px -2px @iconShadow"
                    }
                  },
                  ".card-box": {
                    "width": "100%",
                    ".item-title": {
                      "margin-bottom": "4px"
                    },
                    ".text-wrap": {
                      ".item-text": {
                        "position": "relative",
                        "display": "inline-block",
                        "width": "fit-content",
                        "margin-bottom": "0",
                        "transition": "all .3s ease",
                        "&::before": {
                          "content": "''",
                          "position": "absolute",
                          "bottom": "0",
                          "left": "0",
                          "width": "100%",
                          "height": "1px",
                          "background-color": "@activeColor",
                          "opacity": "0",
                          "transition": "all 0.3s ease-in-out",
                          "transform": "translateY(-2px)"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".btn-wrapper": {
              "margin-top": "0",
              "margin-right": "0"
            },
            ".mbr-label, .label-wrapper": {
              "color": "#334155",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#0f172a",
              "text-align": "center"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#475569",
              "text-align": "center"
            },
            ".item-title": {
              "color": "#0f172a"
            },
            ".item-text": {
              "color": "#475569"
            }
          },
          "_name": "contacts01",
          "_sourceTheme": "launchm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"contacts01 launchm5\" group=\"Contact\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" condition=\"showLabel\" checked>\n        <input type=\"color\" title=\"Label Bg\" value=\"#fafafa\" name=\"labelBg\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"shadow_1\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"shadow_2\" condition=\"showLabel\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\" checked>\n        <header>Form</header>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showCardIcon\" checked>\n        <input type=\"color\" title=\"Icon Bg\" value=\"#334155\" name=\"iconBg\" condition=\"showCardIcon\" selected>\n        <input type=\"color\" title=\"Icon Shadow\" value=\"#cccccc\" name=\"iconShadow\" condition=\"showCardIcon\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"color\" title=\"Active Color\" value=\"#0f172a\" name=\"activeColor\" selected>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"cardShadow_1\">\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"cardShadow_2\">\n        <input type=\"color\" title=\"BG\" value=\"#fafafa\" name=\"cardBg\">\n        <header>Border</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Color\" value=\"#e1e7ed\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f5f5\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f5f5f5\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"border-wrap border_1\"></div>\n                    <div class=\"border-wrap border_2\"></div>\n                    <div class=\"title-wrapper\" mbr-if=\"showLabel || showTitle || showText\">\n                        <div class=\"label-wrapper\" mbr-if=\"showLabel\">\n                            <div class=\"label-wrap card-wrap large-radius\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"card-icon mbr-iconfont mobi-mbri-contact-form mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(51, 65, 85); fill: rgb(51, 65, 85);\"></span>\n                                </div>\n                                <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-label, .label-wrapper\">\n                                    Connect Directly\n                                </p>\n                            </div>\n                        </div>\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                            Get in Touch<br></h2>\n                        <div class=\"text-wrapper\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                Whether you’re ready to start a new project or need expert guidance, we’re here to help.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"row items-wrapper justify-content-center\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                        <div class=\"col-12 col-lg-6 card\">\n                            <div class=\"items-wrap\">\n                                <div class=\"item features-without-image\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"icon-wrapper\" mbr-if=\"showCardIcon\">\n                                            <span mbr-icon class=\"card-icon mbr-iconfont card-wrap little-radius mobi-mbri-letter mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(250, 250, 250); fill: rgb(250, 250, 250);\"></span>\n                                        </div>\n                                        <div class=\"card-box\">\n                                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">\n                                                Email\n                                            </h4>\n                                            <div class=\"text-wrap\">\n                                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text, .text-wrap\">\n                                                    info@gnss.ae</p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"item features-without-image\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"icon-wrapper\" mbr-if=\"showCardIcon\">\n                                            <span mbr-icon class=\"card-icon mbr-iconfont card-wrap little-radius mobi-mbri-phone mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(250, 250, 250); fill: rgb(250, 250, 250);\"></span>\n                                        </div>\n                                        <div class=\"card-box\">\n                                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">\n                                                Call\n                                            </h4>\n                                            <div class=\"text-wrap\">\n                                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text, .text-wrap\">\n                                                    +24-(745)-232-54\n                                                </p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"item features-without-image\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"icon-wrapper\" mbr-if=\"showCardIcon\">\n                                            <span mbr-icon class=\"card-icon mbr-iconfont card-wrap little-radius mobi-mbri-map-pin mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(250, 250, 250); fill: rgb(250, 250, 250);\"></span>\n                                        </div>\n                                        <div class=\"card-box\">\n                                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">\n                                                Location\n                                            </h4>\n                                            <div class=\"text-wrap\">\n                                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text, .text-wrap\">Office 1704,&nbsp;Sidra Tower,&nbsp;Al Sufouh First, Sheikh Zayed Road, Dubai, United Arab Emirates</p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-6 card\" mbr-if=\"showImage\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@PROJECT_PATH@/assets/images/mbr-1008x1008.jpg\" alt=\"Mobirise Website Builder\">\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v4MidjwEhz",
          "_anchor": "contacts01-e",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".card-wrapper": {
              "padding": "60px 60px 0 60px",
              "border-bottom-left-radius": "0 !important",
              "border-bottom-right-radius": "0 !important",
              "background-color": "@cardBg",
              "box-shadow": "inset 0 10px 8px 0 @cardShadow_1, 1px 0 10px -5px @cardShadow_2",
              "overflow": "hidden",
              "margin-top": "-1px",
              "@media (max-width: 992px)": {
                "padding": "20px 20px 0 20px"
              },
              ".content-wrapper": {
                "margin-bottom": "60px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                },
                ".title-wrapper": {
                  ".title-wrap": {
                    "display": "inline-flex",
                    "align-items": "center",
                    "gap": "10px",
                    "flex-wrap": "wrap",
                    "margin-bottom": "12px",
                    ".logo-wrapper": {
                      "img": {
                        "width": "30px",
                        "height": "30px",
                        "min-width": "30px",
                        "object-fit": "cover"
                      }
                    },
                    ".mbr-section-title": {
                      "margin-bottom": "0"
                    }
                  }
                },
                ".text-wrapper": {
                  ".mbr-text": {
                    "display": "inline-block",
                    "width": "80%",
                    "margin-bottom": "0",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    }
                  }
                },
                ".mbr-section-btn": {
                  "margin-top": "10px"
                }
              },
              ".nav-wrapper": {
                "display": "grid",
                "grid-template-columns": "1fr 1fr 1fr",
                "gap": "20px",
                "margin-bottom": "60px",
                "@media (max-width: 1440px)": {
                  "grid-template-columns": "1fr 1fr"
                },
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                },
                "@media (max-width: 768px)": {
                  "grid-template-columns": "1fr"
                },
                ".nav-wrap": {
                  ".mbr-list-title": {
                    "margin-bottom": "20px",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "12px"
                    }
                  },
                  ".list": {
                    "padding": "0",
                    "margin": "0",
                    "list-style-type": "none",
                    "display": "flex",
                    "flex-direction": "column",
                    ".item-wrap": {
                      "position": "relative",
                      "margin-bottom": "16px",
                      "transition": "all 0.3s ease-in-out",
                      "display": "inline-flex",
                      "width": "fit-content",
                      "&::before": {
                        "content": "''",
                        "position": "absolute",
                        "bottom": "0",
                        "left": "0",
                        "width": "100%",
                        "height": "1px",
                        "background-color": "@activeNav",
                        "opacity": "0",
                        "transition": "all 0.3s ease-in-out",
                        "transform": "translateY(-2px)"
                      },
                      "&:hover, &:focus": {
                        "color": "@activeNav",
                        "&::before": {
                          "opacity": "1",
                          "transform": "translateY(0)"
                        }
                      },
                      "&:last-child": {
                        "margin-bottom": "0"
                      },
                      "@media (max-width: 992px)": {
                        "margin-bottom": "8px",
                        "&:last-child": {
                          "margin-bottom": "0"
                        }
                      }
                    }
                  }
                }
              },
              ".copy-wrap": {
                "position": "relative",
                "display": "flex",
                "justify-content": "center",
                "& when (@showCopy)": {
                  "padding": "20px 0"
                },
                ".border-wrap": {
                  "position": "absolute",
                  "top": "0",
                  "width": "1000%",
                  "height": "1px",
                  "background-color": "@border"
                },
                ".mbr-copy": {
                  "width": "100%",
                  "margin-bottom": "0"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#0f172a"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#475569",
              "text-align": "center"
            },
            ".mbr-list-title": {
              "color": "#475569"
            },
            ".list": {
              "color": "#0f172a"
            },
            ".mbr-copy": {
              "color": "#0f172a",
              "text-align": "center"
            },
            ".mbr-section-title, .mbr-section-btn, .icon-wrapper": {
              "text-align": "right"
            },
            ".mbr-section-title, .mbr-section-btn, .title-wrapper": {
              "text-align": "center"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "launchm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 launchm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\">\n        <input type=\"checkbox\" title=\"Navigation Title\" name=\"showNavTitle\" checked condition=\"showNav\">\n        <input type=\"color\" title=\"Active Color\" value=\"#ff6900\" name=\"activeNav\" condition=\"showNav\" selected>\n        <input type=\"range\" inline title=\"Navigation Amount\" name=\"listAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"3\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"cardShadow_1\">\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"cardShadow_2\">\n        <input type=\"color\" title=\"Container BG\" value=\"#fafafa\" name=\"cardBg\" selected>\n        <header>Border</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Color\" value=\"#e1e7ed\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f5f5\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f5f5f5\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-11\">\n                <div class=\"card-wrapper\">\n                    <div class=\"row justify-content-center\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                        <div class=\"col-12 col-lg-6\" mbr-if=\"showLogo || showTitle || showText || showButtons\">\n                            <div class=\"content-wrapper\">\n                                <div class=\"title-wrapper\">\n                                    <div class=\"title-wrap\">\n                                        <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                                            <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/logo.png\" alt=\"Mobirise Website Builder\">\n                                        </div>\n                                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn, .title-wrapper\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\"><b>GNSS.AE</b></h2>\n                                    </div>\n                                </div>\n                                <div class=\"text-wrapper\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                        Professional Drones &amp; GNSS Surveying Solutions\n                                    </p>\n                                </div>\n                                <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                    <a href class=\"btn btn-black\" data-app-placeholder=\"Type Text\">\n                                        Get Started\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-6\" mbr-if=\"showNav\">\n                            <div class=\"nav-wrapper\">\n                                <div class=\"nav-wrap\">\n                                    <h4 class=\"mbr-list-title mbr-fonts-style\" data-app-selector=\".mbr-list-title\" mbr-theme-style=\"display-4\" mbr-if=\"showNavTitle\">\n                                        Menu\n                                    </h4>\n                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                        <li class=\"item-wrap\">Home</li>\n                                        <li class=\"item-wrap\">About</li>\n                                        <li class=\"item-wrap\">Services</li>\n                                    </ul>\n                                </div>\n                                <div class=\"nav-wrap\" mbr-if=\"listAmount > 1\">\n                                    <h4 class=\"mbr-list-title mbr-fonts-style\" data-app-selector=\".mbr-list-title\" mbr-theme-style=\"display-4\" mbr-if=\"showNavTitle\">\n                                        Social\n                                    </h4>\n                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                        <li class=\"item-wrap\">X (Twitter)</li>\n                                        <li class=\"item-wrap\">Facebook</li>\n                                        <li class=\"item-wrap\">Linked In</li>\n                                    </ul>\n                                </div>\n                                <div class=\"nav-wrap\" mbr-if=\"listAmount > 2\">\n                                    <h4 class=\"mbr-list-title mbr-fonts-style\" data-app-selector=\".mbr-list-title\" mbr-theme-style=\"display-4\" mbr-if=\"showNavTitle\">\n                                        Contacts\n                                    </h4>\n                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                        <li class=\"item-wrap\">+24-(745)-232-54</li>\n                                        <li class=\"item-wrap\">mobi@rise.com</li>\n                                    </ul>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12\" mbr-if=\"showCopy || showBorder\">\n                            <div class=\"copy-wrap\">\n                                <div class=\"border-wrap\" mbr-if=\"showBorder\"></div>\n                                <p class=\"mbr-copy mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-copy\">\n                                    © Copyright 2023&nbsp; - All Rights Reserved\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v4MiitOyAL",
          "_anchor": "footer01-h",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    }
  }
}