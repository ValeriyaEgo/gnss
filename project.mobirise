          "_name": "pricing02",
          "_sourceTheme": "launchm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"pricing02 launchm5\" group=\"Pricing\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" condition=\"showLabel\" checked>\n        <input type=\"color\" title=\"Label Bg\" value=\"#fafafa\" name=\"labelBg\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"shadow_1\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"shadow_2\" condition=\"showLabel\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"cardShadow_1\">\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"cardShadow_2\">\n        <input type=\"color\" title=\"BG\" value=\"#fafafa\" name=\"cardBg\">\n        <input type=\"color\" title=\"Gradient\" value=\"#e92f35\" name=\"gradient\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"gradientOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\">\n        <header>Border</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Color\" value=\"#e1e7ed\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f5f5\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f5f5f5\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"border-wrap border_1\"></div>\n                    <div class=\"border-wrap border_2\"></div>\n                    <div class=\"title-wrapper\" mbr-if=\"showLabel || showTitle || showText\">\n                        <div class=\"label-wrapper\" mbr-if=\"showLabel\">\n                            <div class=\"label-wrap card-wrap large-radius\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"card-icon mbr-iconfont mobi-mbri-success mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(51, 65, 85); fill: rgb(51, 65, 85);\"></span>\n                                </div>\n                                <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-label, .label-wrapper\">\n                                    Premium Solutions\n                                </p>\n                            </div>\n                        </div>\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">End-to-End Integrated Solutions</h2>\n                        <div class=\"text-wrapper\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                Complete, industry-ready drone and geospatial systems delivered, configured, and supported under one contract.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"row items-wrapper justify-content-center\">\n                        <div class=\"col-12 col-lg-6 item features-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-img\">\n                                    <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/image19.jpg\" alt=\"Mobirise Website Builder\">\n                                </div>\n                                <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-price, .mbr-section-btn\">\n                                    $12000\n                                </p>\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">Professional Survey &amp; Inspection System</h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">A fully integrated drone-based data acquisition system combining enterprise UAV platform, mission-specific payload (LiDAR / RGB / Thermal), GNSS RTK precision positioning, advanced processing software, and certified operator training.<br><br>Designed for construction monitoring, infrastructure inspection, corridor mapping, and high-accuracy surveying projects requiring centimeter-level precision and operational reliability.</p>\n                                <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                    <a href class=\"btn btn-black\" data-app-placeholder=\"Type Text\">\n                                        Select Service\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-6 item features-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-img\">\n                                    <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/image17.jpg\" alt=\"Mobirise Website Builder\">\n                                </div>\n                                <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-price, .mbr-section-btn\">\n                                    $18000\n                                </p>\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">Enterprise Aerial Operations Suite</h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">A scalable enterprise-grade aerial operations ecosystem built for large organizations managing multiple sites and teams. Includes drone platform, interchangeable payload systems, GNSS RTK infrastructure, advanced data processing software, workflow integration, extended warranty, priority support, and operational training programs.<br><br>Optimized for energy, utilities, oil &amp; gas, smart cities, and infrastructure operators requiring standardized deployment across projects.</p>\n                                <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                    <a href class=\"btn btn-black\" data-app-placeholder=\"Type Text\">\n                                        Select Service\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v4MihDGUfV",
          "_anchor": "pricing02-g",
