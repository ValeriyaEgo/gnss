                      "box-shadow": "inset 0 10px 8px 0 @shadow_1, inset 0 -5px 10px -8px @shadow_2, 0 10px 10px -8px @shadow_2",
                      "background-color": "@labelBg",
                      ".iconfont-wrapper": {
